# Auto detect text files and normalize line endings to LF
* text=auto

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Documentation
*.md text eol=lf

# Source code
*.cs text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sql text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.db binary
